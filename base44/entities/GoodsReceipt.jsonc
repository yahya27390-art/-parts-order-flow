{
  "name": "GoodsReceipt",
  "type": "object",
  "properties": {
    "receipt_number": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0625\u0630\u0646 \u0627\u0644\u0627\u0633\u062a\u0644\u0627\u0645"
    },
    "order_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0637\u0644\u0628 \u0627\u0644\u0634\u0631\u0627\u0621"
    },
    "order_number": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0637\u0644\u0628 \u0627\u0644\u0634\u0631\u0627\u0621"
    },
    "receipt_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0648\u0648\u0642\u062a \u0627\u0644\u0627\u0633\u062a\u0644\u0627\u0645"
    },
    "total_amount": {
      "type": "number",
      "default": 0,
      "description": "\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0628\u0644\u063a"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "last_modified_by": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0630\u064a \u0642\u0627\u0645 \u0628\u0622\u062e\u0631 \u062a\u0639\u062f\u064a\u0644"
    },
    "last_modified_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0648\u0648\u0642\u062a \u0622\u062e\u0631 \u062a\u0639\u062f\u064a\u0644"
    }
  },
  "required": [
    "order_id",
    "receipt_date"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}