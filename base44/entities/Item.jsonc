{
  "name": "Item",
  "type": "object",
  "properties": {
    "item_number": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0635\u0646\u0641 (\u0645\u062b\u0627\u0644: 97701-F1500)"
    },
    "item_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0635\u0646\u0641"
    },
    "brand": {
      "type": "string",
      "enum": [
        "hyundai",
        "kia",
        "other"
      ],
      "default": "other",
      "description": "\u0627\u0644\u0645\u0627\u0631\u0643\u0629: \u0647\u064a\u0648\u0646\u062f\u0627\u064a / \u0643\u064a\u0627 / \u0623\u062e\u0631\u0649"
    },
    "cost": {
      "type": "number",
      "description": "\u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u0635\u0646\u0641"
    },
    "current_stock": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0631\u0635\u064a\u062f \u0627\u0644\u062d\u0627\u0644\u064a \u0639\u0646\u062f \u0627\u0644\u0645\u062e\u0632\u0648\u0646 \u0627\u0644\u0645\u0641\u062a\u0648\u062d"
    },
    "pending_stock": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0631\u0635\u064a\u062f \u0648\u0642\u062a \u0627\u0644\u0645\u062e\u0632\u0648\u0646 \u0627\u0644\u0637\u0644\u0628"
    },
    "average_cost": {
      "type": "number",
      "default": 0,
      "description": "\u0645\u062a\u0648\u0633\u0637 \u0627\u0644\u062a\u0643\u0644\u0641\u0629"
    }
  },
  "required": [
    "item_number",
    "item_name"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}